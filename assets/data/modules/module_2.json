  "module": {
    "metadata": {"id": "module_2", "number": 2, "type": "descriptive_text", "title": "Descriptive Text", "subtitle": "Retail Products & Store Fixtures", "overview": "Descriptive Text is a text that describes a specific object, place, or item in detail. In retail, it is used to describe merchandise specifications, store fixtures, and product selling points.", "contentStatus": "source_final", "subtitleStatus": "source_final"},
    "objectives": [
      {"id": "m2_objective_01", "text": "Mengidentifikasi fungsi sosial teks berkaitan retail.", "contentStatus": "prototype_derived"},
      {"id": "m2_objective_02", "text": "Mengenali struktur generik dan ciri kebahasaan.", "contentStatus": "prototype_derived"},
      {"id": "m2_objective_03", "text": "Memahami ide pokok dan informasi rinci.", "contentStatus": "prototype_derived"},
      {"id": "m2_objective_04", "text": "Menggunakan kosakata retail dalam konteks bermakna.", "contentStatus": "prototype_derived"}
    ],
    "theory": {
      "contentStatus": "source_final",
      "definition": "Descriptive Text is a text that describes a specific object, place, or item in detail. In retail, it is used to describe merchandise specifications, store fixtures, and product selling points.",
      "genericStructure": [
        {"id": "m2_structure_identification", "heading": "Identification", "detail": "Introduces the retail product or store fixture being described."},
        {"id": "m2_structure_description", "heading": "Description", "detail": "Details the physical features, materials, size, colors, durability, and functions of the item."}
      ],
      "languageFeatures": [
        {"id": "m2_feature_simple_present", "heading": "Simple Present Tense", "detail": "e.g., features, includes, measures, contains."},
        {"id": "m2_feature_adjectives", "heading": "Adjectives of Quality & Appearance", "detail": "e.g., durable, sleek, ergonomic, sturdy."},
        {"id": "m2_feature_noun_phrases", "heading": "Noun Phrases", "detail": "e.g., heavy-duty shelving, dual-screen terminal."}
      ]
    },
    "vocabulary": [
