      {"id": "m2_vocab_durable", "term": "Durable", "partOfSpeech": "adjective", "meaning": "Tahan lama / awet.", "audioKey": "m2-2", "contentStatus": "source_final"},
      {"id": "m2_vocab_adjustable", "term": "Adjustable", "partOfSpeech": "adjective", "meaning": "Dapat disesuaikan tingginya/ukurannya.", "audioKey": "m2-3", "contentStatus": "source_final"},
      {"id": "m2_vocab_display", "term": "Display", "partOfSpeech": "noun/verb", "meaning": "Penataan/pajangan barang.", "audioKey": "m2-4", "contentStatus": "source_final"},
