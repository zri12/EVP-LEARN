    ],
    "readings": [
      {
        "id": "m2_reading_01", "title": "Modern Touchscreen POS Terminal", "subtitle": "Retail Hardware / POS System", "category": "Electronic Merchandise (Point of Sale Machine)", "imageKey": null, "readingAudioKey": "m2-1", "contentStatus": "source_final",
        "sections": [{"id": "m2_r1_section_identification_description", "heading": "IDENTIFICATION & DESCRIPTION", "body": "The OmniTouch 500 is a modern touchscreen POS terminal designed for fast-paced retail stores. It features a sleek black casing made of high-impact ABS plastic and a 15.6-inch dual-screen display that allows both cashiers and customers to view transactions simultaneously. At the top of the main unit, there is an integrated thermal receipt printer that operates quietly and at high speed. Supported by a sturdy metallic stand with a rust-resistant finish, this device ensures smooth checkout operations while maintaining an elegant aesthetic on the cashier counter.", "glossaryIds": ["m2_r1_glossary_casing", "m2_r1_glossary_dual_screen_display", "m2_r1_glossary_integrated", "m2_r1_glossary_sturdy", "m2_r1_glossary_finish"]}],
        "glossary": [
          {"id": "m2_r1_glossary_casing", "term": "Casing", "partOfSpeech": "noun", "meaning": "Wadah / pelindung luar perangkat.", "audioKey": "casing", "contentStatus": "source_final"},
          {"id": "m2_r1_glossary_dual_screen_display", "term": "Dual-screen display", "partOfSpeech": "noun phrase", "meaning": "Layar ganda (layar untuk kasir dan layar pembeli).", "audioKey": "dual-screen-display", "contentStatus": "source_final"},
          {"id": "m2_r1_glossary_integrated", "term": "Integrated", "partOfSpeech": "adjective", "meaning": "Menyatu / terintegrasi menjadi satu unit.", "audioKey": "integrated", "contentStatus": "source_final"},
          {"id": "m2_r1_glossary_sturdy", "term": "Sturdy", "partOfSpeech": "adjective", "meaning": "Kokoh / kuat / tidak mudah goyah.", "audioKey": "sturdy", "contentStatus": "source_final"},
          {"id": "m2_r1_glossary_finish", "term": "Finish", "partOfSpeech": "noun", "meaning": "Lapisan akhir permukaan bahan (misal: anti karat/matte).", "audioKey": "finish", "contentStatus": "source_final"}
        ]
      },
      {
        "id": "m2_reading_02", "title": "Heavy-Duty Supermarket Gondola Shelving", "subtitle": "Store Fixtures & Display", "category": "Supermarket Display Fixture (Store Layout)", "imageKey": null, "readingAudioKey": "m2-2", "contentStatus": "source_final",
        "sections": [{"id": "m2_r2_section_identification_description", "heading": "IDENTIFICATION & DESCRIPTION", "body": "This heavy-duty gondola shelving unit is built specifically for organizing supermarket merchandise efficiently. Standing 2 meters tall, it consists of five adjustable steel shelves painted in a durable matte white powder coating. Each shelf is engineered to support up to 100 kilograms of goods, making it ideal for heavy food packaging and household cleaning items. Its open-front design provides high product visibility, allowing shoppers to easily locate and reach items while maximizing aisle space.", "glossaryIds": ["m2_r2_glossary_gondola_shelving", "m2_r2_glossary_adjustable", "m2_r2_glossary_durable", "m2_r2_glossary_open_front", "m2_r2_glossary_visibility"]}],
        "glossary": [
          {"id": "m2_r2_glossary_gondola_shelving", "term": "Gondola shelving", "partOfSpeech": "noun phrase", "meaning": "Rak display dua sisi/satu sisi yang biasa digunakan di supermarket/minimarket.", "audioKey": "gondola-shelving", "contentStatus": "source_final"},
          {"id": "m2_r2_glossary_adjustable", "term": "Adjustable", "partOfSpeech": "adjective", "meaning": "Dapat disesuaikan (ketinggian/posisinya).", "audioKey": "adjustable", "contentStatus": "source_final"},
          {"id": "m2_r2_glossary_durable", "term": "Durable", "partOfSpeech": "adjective", "meaning": "Tahan lama / awet / tidak mudah rusak.", "audioKey": "durable", "contentStatus": "source_final"},
          {"id": "m2_r2_glossary_open_front", "term": "Open-front", "partOfSpeech": "adjective", "meaning": "Berdesain terbuka bagian depan.", "audioKey": "open-front", "contentStatus": "source_final"},
          {"id": "m2_r2_glossary_visibility", "term": "Visibility", "partOfSpeech": "noun", "meaning": "Tingkat keterlihatan produk oleh pelanggan.", "audioKey": "visibility", "contentStatus": "source_final"}
        ]
      },
      {
        "id": "m2_reading_03", "title": "Vintage Leather Biker Jacket", "subtitle": "Fashion & Merchandise Display", "category": "Fashion Retail Merchandise (Apparel Display)", "imageKey": null, "readingAudioKey": "m2-3", "contentStatus": "source_final",
        "sections": [{"id": "m2_r3_section_identification_description", "heading": "IDENTIFICATION & DESCRIPTION", "body": "The Urban Rider Jacket is a classic black biker-style leather jacket crafted for front-window retail display. Made from premium genuine cowhide leather, it features a smooth texture with a subtle natural shine. The jacket includes asymmetrical silver zippers, a snap-button collar, and an adjustable waist belt for a custom fit. Its bold design and high-quality craftsmanship make it an eye-catching centerpiece that attracts potential fashion shoppers into the store.", "glossaryIds": ["m2_r3_glossary_premium", "m2_r3_glossary_asymmetrical", "m2_r3_glossary_adjustable", "m2_r3_glossary_eye_catching", "m2_r3_glossary_centerpiece"]}],
        "glossary": [
          {"id": "m2_r3_glossary_premium", "term": "Premium", "partOfSpeech": "adjective", "meaning": "Berkualitas tinggi / bermutu super.", "audioKey": "premium", "contentStatus": "source_final"},
          {"id": "m2_r3_glossary_asymmetrical", "term": "Asymmetrical", "partOfSpeech": "adjective", "meaning": "Tidak simetris (desain ritsleting miring khas jaket biker).", "audioKey": "asymmetrical", "contentStatus": "source_final"},
          {"id": "m2_r3_glossary_adjustable", "term": "Adjustable", "partOfSpeech": "adjective", "meaning": "Dapat diatur (ukuran lingkar pinggangnya).", "audioKey": "adjustable", "contentStatus": "source_final"},
          {"id": "m2_r3_glossary_eye_catching", "term": "Eye-catching", "partOfSpeech": "adjective", "meaning": "Menarik perhatian / mencolok untuk dilihat.", "audioKey": "eye-catching", "contentStatus": "source_final"},
          {"id": "m2_r3_glossary_centerpiece", "term": "Centerpiece", "partOfSpeech": "noun", "meaning": "Produk utama yang menjadi pusat perhatian tampilan display window toko.", "audioKey": "centerpiece", "contentStatus": "source_final"}
        ]
      }
    ],
